# Copy to .env.local and replace placeholders. Never commit real secrets.

# Supabase browser configuration (publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Supabase server key (server-only; never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# NVIDIA NIM text generation (server-only)
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_STUDENT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_SUPPORT_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_ADMIN_MODEL=nvidia/nemotron-3-super-120b-a12b

# NVIDIA speech (server-only)
NVIDIA_TTS_FUNCTION_ID=877104f7-e885-42b9-8de8-f6e4c6303969
NVIDIA_ASR_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081
NVIDIA_SPEECH_LANGUAGE=en-US

# Paystack (server-only; begin with test credentials)
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret
PAYSTACK_CALLBACK_URL=https://your-domain.example/api/paystack/callback

# M-Pesa Daraja (server-only; sandbox until production approval)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=YOUR_MPESA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_MPESA_CONSUMER_SECRET
MPESA_PASSKEY=YOUR_MPESA_PASSKEY
MPESA_TILL_NUMBER=YOUR_MPESA_SHORT_CODE
MPESA_CALLBACK_URL=https://your-domain.example/api/mpesa/callback

# Other application settings
NEXT_PUBLIC_CRON_SECRET=GENERATE_A_RANDOM_SECURE_STRING
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_SITE_KEY
